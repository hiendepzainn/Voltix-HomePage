  <div class="voltix-footer__part-2">
    <div class="voltix-footer__grid">
      {%- if has_column_blocks -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'text_block' -%}
            <div class="voltix-footer__col" {{ block.shopify_attributes }}>
              <p class="voltix-footer__text-content">{{ block.settings.content }}</p>
            </div>
          {%- elsif block.type == 'nav_block' -%}
            <div class="voltix-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h3 class="voltix-footer__col-title">{{ block.settings.heading }}</h3>
              {%- endif -%}

              <ul class="voltix-footer__nav-list">
                {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="voltix-footer__nav-link">
                        {{ link.title }}
                      </a>
                    </li>
                  {%- endfor -%}
                {%- else -%}
                  {%- assign heading_upcase = block.settings.heading | upcase | strip -%}
                  {%- if heading_upcase == 'HELP INFO' -%}
                    <li><a href="#" class="voltix-footer__nav-link">About Us</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Blogs</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Contact Us</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">FAQ</a></li>
                  {%- elsif heading_upcase == 'POLICIES' -%}
                    <li><a href="#" class="voltix-footer__nav-link">Privacy Policy</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Refund Policy</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Shipping Policy</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Terms of Service</a></li>
                  {%- else -%}
                    <li><a href="#" class="voltix-footer__nav-link">Headphones</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Earbuds</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Speakers</a></li>
                    <li><a href="#" class="voltix-footer__nav-link">Smart Watch</a></li>
                  {%- endif -%}
                {%- endif -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="voltix-footer__col">
          <p class="voltix-footer__text-content">
            We're Passionate About Creating Smarter, Better-connected Lifestyles Through Innovative Electronics Designed
            To Bring Greater Convenience, Comfort, And Efficiency To Everyday Modern Living.
          </p>
        </div>

        <div class="voltix-footer__col">
          <h3 class="voltix-footer__col-title">SHOP</h3>
          <ul class="voltix-footer__nav-list">
            <li><a href="#" class="voltix-footer__nav-link">Headphones</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Earbuds</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Speakers</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Smart Watch</a></li>
          </ul>
        </div>

        <div class="voltix-footer__col">
          <h3 class="voltix-footer__col-title">HELP INFO</h3>
          <ul class="voltix-footer__nav-list">
            <li><a href="#" class="voltix-footer__nav-link">About Us</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Blogs</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Contact Us</a></li>
            <li><a href="#" class="voltix-footer__nav-link">FAQ</a></li>
          </ul>
        </div>

        <div class="voltix-footer__col">
          <h3 class="voltix-footer__col-title">POLICIES</h3>
          <ul class="voltix-footer__nav-list">
            <li><a href="#" class="voltix-footer__nav-link">Privacy Policy</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Refund Policy</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Shipping Policy</a></li>
            <li><a href="#" class="voltix-footer__nav-link">Terms of Service</a></li>
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionEl = document.querySelector('.voltix-footer-{{ section.id }}');
    if (!sectionEl) return;

    const navLinks = sectionEl.querySelectorAll('.voltix-footer__nav-link');
    navLinks.forEach((link) => {
      link.addEventListener(
        'touchstart',
        function () {
          this.classList.add('is-touched');
        },
        { passive: true }
      );

      link.addEventListener(
        'touchend',
        function () {
          setTimeout(() => this.classList.remove('is-touched'), 250);
        },
        { passive: true }
      );
    });
  });
</script>

