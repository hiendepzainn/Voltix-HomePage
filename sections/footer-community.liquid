{%- style -%}
  #shopify-section-{{ section.id }} {
    --bg-color: {{ section.settings.bg_color }};
    --accent-color: {{ section.settings.accent_color }};
    --text-color: {{ section.settings.text_color }};
    --border-color: {{ section.settings.border_color }};
    --btn-bg: {{ section.settings.btn_bg_color }};
    --btn-text: {{ section.settings.btn_text_color }};
    --section-pt: {{ section.settings.padding_top }}px;
    --section-pb: {{ section.settings.padding_bottom }}px;
  }

  .voltix-footer-{{ section.id }} {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: var(--bg-color);
    color: var(--text-color);
    padding-top: var(--section-pt);
    padding-bottom: var(--section-pb);
    font-family: inherit;
    overflow: hidden;
    font-family: 'Mona Sans', sans-serif;
  }


  .voltix-footer__part-1 {
    width: 100%;
    max-width: 860px;
    margin: 0 auto;
    padding: 0 20px 56px;
    text-align: center;
    box-sizing: border-box;
  }

  .voltix-footer__heading {
    color: var(--accent-color);
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.15;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  .voltix-footer__desc {
    color: var(--text-color);
    font-size: clamp(13px, 1.5vw, 15px);
    line-height: 1.6;
    margin: 0 auto 32px;
    max-width: 640px;
    opacity: 0.92;
  }

  /* Form nhập Email */
  .voltix-footer__form-wrapper {
    max-width: 560px;
    margin: 0 auto 32px;
  }

  .voltix-footer__input-group {
    display: flex;
    align-items: center;
    background-color: #ffffff;
    border-radius: 999px;
    padding: 5px 5px 5px 24px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }

  .voltix-footer__input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    color: #182013;
    font-size: 14px;
    padding: 10px 12px 10px 0;
    width: 100%;
  }

  .voltix-footer__input::placeholder {
    color: #555555;
  }

  .voltix-footer__submit {
    background-color: var(--btn-bg);
    color: var(--btn-text);
    border: 1.5px solid var(--btn-bg);
    border-radius: 999px;
    padding: 12px 28px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
    white-space: nowrap;
  }

  .voltix-footer__submit:hover {
    background-color: var(--btn-text);
    color: var(--btn-bg);
    border-color: var(--btn-bg);
  }

  .voltix-footer__message {
    margin-top: 12px;
    font-size: 13px;
  }

  .voltix-footer__message--success {
    color: var(--accent-color);
  }

  .voltix-footer__message--error {
    color: #ff8a8a;
  }

  .voltix-footer__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 32px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .voltix-footer__social-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--text-color);
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .voltix-footer__social-link:hover {
    color: var(--accent-color);
    transform: translateY(-2px);
  }

  .voltix-footer__social-icon {
    width: 16px;
    height: 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .voltix-footer__social-icon svg {
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .voltix-footer__part-2 {
    width: 100%;
    border-top: 1px solid var(--border-color);
  }

  .voltix-footer__grid {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }

  .voltix-footer__col {
    padding: 48px 40px;
    border-right: 1px solid var(--border-color);
    box-sizing: border-box;
  }

  .voltix-footer__col:last-child {
    border-right: none;
  }

  .voltix-footer__text-content {
    font-size: 13.5px;
    line-height: 1.75;
    color: var(--text-color);
    opacity: 0.9;
    margin: 0;
  }

  .voltix-footer__col-title {
    color: var(--accent-color);
    font-size: 20px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0 0 22px;
  }

  .voltix-footer__nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .voltix-footer__nav-link {
    display: inline-block;
    color: var(--text-color);
    text-decoration: none;
    font-size: 13.5px;
    line-height: 1.4;
    opacity: 0.9;
    transition: transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1), color 0.25s ease, opacity 0.25s ease;
  }

  .voltix-footer__nav-link:hover,
  .voltix-footer__nav-link:focus,
  .voltix-footer__nav-link:active,
  .voltix-footer__nav-link.is-touched {
    transform: translateX(7px);
    color: var(--accent-color);
    opacity: 1;
  }

  @media screen and (max-width: 1024px) {
    .voltix-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .voltix-footer__col {
      padding: 36px 28px;
      border-bottom: 1px solid var(--border-color);
    }

    .voltix-footer__col:nth-child(2n) {
      border-right: none;
    }
  }

  @media screen and (max-width: 767px) {
    .voltix-footer__part-1 {
      padding: 0 16px 40px;
    }

    .voltix-footer__input-group {
      flex-direction: column;
      background-color: transparent;
      padding: 0;
      box-shadow: none;
      gap: 12px;
    }

    .voltix-footer__input {
      background-color: #ffffff;
      border-radius: 999px;
      padding: 14px 20px;
      box-sizing: border-box;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    }

    .voltix-footer__submit {
      width: 100%;
      padding: 14px 24px;
      border-color: var(--accent-color);
    }

    .voltix-footer__socials {
      gap: 14px 20px;
    }

    .voltix-footer__grid {
      grid-template-columns: 1fr;
    }

    .voltix-footer__col {
      padding: 28px 20px;
      border-right: none !important;
      border-bottom: 1px solid var(--border-color);
    }

    .voltix-footer__col:last-child {
      border-bottom: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign social_blocks = section.blocks | where: 'type', 'social_link'
  assign has_column_blocks = false
  for block in section.blocks
    if block.type == 'text_block' or block.type == 'nav_block'
      assign has_column_blocks = true
      break
    endif
  endfor
-%}

<footer class="voltix-footer-{{ section.id }}">
  <div class="voltix-footer__part-1">
    {%- if section.settings.heading != blank -%}
      <h2 class="voltix-footer__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="voltix-footer__desc">{{ section.settings.description }}</p>
    {%- endif -%}

    <div class="voltix-footer__form-wrapper">
      {%- form 'customer', class: 'voltix-footer__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="voltix-footer__input-group">
          <input
            type="email"
            name="contact[email]"
            class="voltix-footer__input"
            value="{{ form.email }}"
            placeholder="{{ section.settings.email_placeholder | default: 'Email address...' }}"
            aria-label="{{ section.settings.email_placeholder | default: 'Email address...' }}"
            required
          >
          <button type="submit" class="voltix-footer__submit">
            {{ section.settings.button_label | default: 'SUBSCRIBE' }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <div class="voltix-footer__message voltix-footer__message--success">
            {{ section.settings.success_message | default: 'Thanks for subscribing!' }}
          </div>
        {%- elsif form.errors -%}
          <div class="voltix-footer__message voltix-footer__message--error">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </div>
        {%- endif -%}
      {%- endform -%}
    </div>

    <ul class="voltix-footer__socials">
      {%- if social_blocks.size > 0 -%}
        {%- for block in social_blocks -%}
          <li {{ block.shopify_attributes }}>
            <a
