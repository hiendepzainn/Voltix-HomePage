<div class="header">
  <div class="area area1">
    <span>shop</span>
    <span>collections</span>
    <span>about</span>
    <span>blog</span>
    <span>contact</span>
    <div>{{ 'icon-menu.svg' | inline_asset_content }}</div>
  </div>

  <div class="area area2">
    <span>{{ section.settings.shop_name }}</span>
  </div>

  <div class="area area3">
    <div>
      <span class="icon-header">{{ 'icon-search.svg' | inline_asset_content }}</span>
      <span class="text">search</span>
    </div>

    <div>
      <span class="icon-header">{{ 'icon-account.svg' | inline_asset_content }}</span>
      <span class="text">sign in / register</span>
    </div>

    <div>
      <span class="icon-header">{{ 'icon-cart.svg' | inline_asset_content }}</span>
      <span class="text">cart</span>
      {% if cart.item_count > 0 %}
        <span>{{ cart.item_count }}</span>
      {% endif %}
    </div>
  </div>
</div>

<script src="{{ 'js-header.js' | asset_url }}" defer="defer"></script>

{% style %}
  .shopify-section:has(.header) {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .header {
    display: flex;
    justify-content: center;
    padding-top: {{ section.settings.padding }}rem;
    padding-bottom: {{ section.settings.padding }}rem;
    background-color: {{ section.settings.background_color_not_scroll }};
    margin-bottom: {{0 | minus: 4 | minus: section.settings.padding | minus: section.settings.padding | plus: 1.6 }}rem;
    border-bottom: 1px solid #b3b3b389;
    transition: background-color 0.3s ease;
  }

  .header .area {
    width: 33vw;
    /* background-color: antiquewhite; */
  }

  .header .area1 {
    display: flex;
    justify-content: space-around;
    align-items: center;
  }

  .header .area1 span {
    text-transform: {{ section.settings.text_transform }};
    color: {{ section.settings.text_color_not_scroll }};
    transition: color 0.3s ease;
    cursor: pointer;
  }

  .header .area1 svg {
    width: 1.5rem;
    color: {{ section.settings.text_color_not_scroll }};
    display: none;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .header .area2 {
    {% if section.settings.is_show_borders %}
      border-left: 2px solid #b3b3b389;
      border-right: 2px solid #b3b3b389;
    {% endif %}
    display: flex;
    justify-content: center;
    align-items: center;
    text-transform: {{ section.settings.text_transform }};
    font-weight: 600;
    font-size: 2rem;
    color: {{ section.settings.text_color_not_scroll }};
    transition: color 0.3s ease;
  }

  .header .area2 span {
    cursor: pointer;
  }

  .header .area3 {
    display: flex;
    justify-content: space-around;
  }

  .header .area3 > div {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .header .area3 svg {
    width: 1.5rem;
    margin-right: 0.5rem;
  }

  .header .area3 span {
    text-transform: {{ section.settings.text_transform }};
    color: {{ section.settings.text_color_not_scroll }};
    transition: color 0.3s ease;

  }

  .header .area3 .text{
    {% if section.settings.is_hide_text %}
      display:none;
    {% endif %}
  }

  .header.scrolled {
    background-color: {{ section.settings.background_color_scroll }};
  }

  .header.scrolled .area1 span,
  .header.scrolled .area2,
  .header.scrolled .area3 span {
    color: {{ section.settings.text_color_scroll }};
  }

  @media screen and (max-width: 1500px) {
    .header .area3 {
      display: flex;
      justify-content: flex-end;
    }

    .header .area3 > div {
      margin-right: 2rem;
    }

    .header .area3 > div .text {
      display: none;
    }
  }

  @media screen and (max-width: 1300px) {
    .header .area1 {
      justify-content: flex-start;
    }

    .header .area1 span {
      display: none;
    }

    .header .area1 svg {
      display: block;
      margin-left: 2rem;
    }

    .header.scrolled .area1 svg {
      color: {{ section.settings.text_color_scroll }};
    }

    .header .area2 {
      border: none;
    }
  }

  @media screen and (max-width: 990px) {
    .header .area3 > div:nth-child(2) .icon-header {
      display: none;
    }

    .header .area3 > div {
      margin-right: 1rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "shop_name",
      "label": "Tên cửa hàng",
      "default": "voltix"
    },

    {
      "type": "color",
      "id": "text_color_not_scroll",
      "label": "Màu chữ (chưa cuộn)",
      "default": "#fff"
    },

    {
      "type": "color",
      "id": "background_color_not_scroll",
      "label": "Màu nền (chưa cuộn)",
      "default": "transparent"
    },

    {
      "type": "color",
      "id": "text_color_scroll",
      "label": "Màu chữ (đã cuộn)",
      "default": "#000"
    },

    {
      "type": "color",
      "id": "background_color_scroll",
      "label": "Màu nền (đã cuộn)",
      "default": "#fff"
    },

    {
      "type": "checkbox",
      "id": "is_show_borders",
      "label": "Hiển thị vách ngăn",
      "default": true
    },

    {
      "type": "select",
      "id": "text_transform",
      "label": "Kiểu chữ",
      "default": "uppercase",
      "options": [
        {
          "value": "uppercase",
          "label": "Viết hoa hết"
        },
        {
          "value": "lowercase",
          "label": "Viết thường hết"
        },
        {
          "value": "capitalize",
          "label": "Viết hoa chữ đầu"
        }
      ]
    },

    {
      "type": "checkbox",
      "id": "is_hide_text",
      "label": "Ẩn chữ",
      "default": false
    },

    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 3,
      "step": 0.1,
      "unit": "rem",
      "label": "Padding",
      "default": 0.8
    }
  ]
}
{% endschema %}
