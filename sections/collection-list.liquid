<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
/>

<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js" defer="defer"></script>

{%- assign fake_collections = '
      1|immersive audio|headphones|//voltix-demo.myshopify.com/cdn/shop/files/Rectangle_649_9.png?v=1787576816&width=1200|7,
      2|wireless sound|earbuds|//voltix-demo.myshopify.com/cdn/shop/files/Rectangle_649_10.png?v=1787576817&width=1200|4,
      3|home audio|speakers|//voltix-demo.myshopify.com/cdn/shop/files/Rectangle_649_11.png?v=1787576816&width=1200|5,
      4|smart wearables|smart watches|//voltix-demo.myshopify.com/cdn/shop/files/Rectangle_649_12.png?v=1787576816&width=1200|4
    '
  | split: ','
-%}

<div class="collection-list">
  <h1>explore collections</h1>
  <div class="swiper swiper-container-{{ section.id }}">
    <!-- Tầng 1: Khung chứa tổng thể (overflow: hidden) -->
    <div class="swiper-wrapper">
      <!-- Tầng 2: Khung chứa dịch chuyển (flex container do Swiper quản lý) -->

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="swiper-slide">
            <div class="view">
              <img src="{{ block.settings.image | image_url}}" alt="image" width="100%" height="100%">
              <div>{{ block.settings.description }}</div>
            </div>
            <div class="info">
              <div>0{{ block.settings.id }}. {{ block.settings.device_type }}</div>
              <div>{{ block.settings.quantity }}</div>
            </div>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- for item in fake_collections -%}
          {%- assign item_data = item | strip | split: '|' -%}
          {%- assign id = item_data[0] -%}
          {%- assign description = item_data[1] -%}
          {%- assign device_type = item_data[2] -%}
          {%- assign image_url = item_data[3] -%}
          {%- assign quantity = item_data[4] -%}

          <div class="swiper-slide">
            <div class="view">
              <img src="{{image_url}}" alt="image" width="100%" height="100%">
              <div>{{ description }}</div>
            </div>
            <div class="info">
              <div>0{{ id }}. {{ device_type }}</div>
              <div>{{ quantity }}</div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="swiper-scrollbar-wrapper">
      <div class="swiper-scrollbar"></div>
    </div>
  </div>
</div>

{%- stylesheet -%}
  .collection-list {
    padding: 4.5rem 15vw;
    font-family: 'Mona Sans', sans-serif;
    background-color: #f4f5f4;
  }

  .collection-list > h1 {
    text-transform: uppercase;
    font-size: 2.5rem;
    color: #3e4430;
    margin-bottom: 1.7rem;
  }

  .collection-list .swiper .view {
    position: relative;
    margin-bottom: 1rem;
  }

  .collection-list .swiper .view > div {
    position: absolute;
    bottom: 1.1rem;
    left: 1.6rem;
    color: #fff;
    text-transform: capitalize;
  }

  .collection-list .swiper .info {
    display: flex;
    justify-content: space-between;
    padding: 1rem 1rem;
    background-color: #ecefe9;
    color: #3e4430;
    border-radius: 10px;
    text-transform: capitalize;
  }

  .collection-list .swiper .swiper-scrollbar-wrapper {
    display: flex;
    justify-content: center;
  }

  .collection-list .swiper .swiper-scrollbar {
    background: rgba(0, 0, 0, 0.1);
    height: 4px;
    border-radius: 4px;
    margin-top: 20px;
    position: relative !important;
    width: 20%;
  }

  .collection-list .swiper .swiper-scrollbar-drag {
    background: #3e4430;
    border-radius: 4px;
    width: 20%;
  }

  @media screen and (max-width: 1500px) {
    .collection-list {
      padding: 4rem 10vw;
    }
  }

  @media screen and (max-width: 1300px) {
    .collection-list {
      padding: 3.5rem 8vw;
    }

    .collection-list > h1 {
      font-size: 2rem;
    }
  }

  @media screen and (max-width: 750px) {
    .collection-list > h1 {
      text-align: center;
      font-size: 1.7rem;
    }
  }
{%- endstylesheet -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const swiper = new Swiper('.swiper-container-{{ section.id }}', {
      slidesPerView: 2,
      spaceBetween: 16,
      grabCursor: true,
      scrollbar: {
        el: '.swiper-scrollbar',
        draggable: true,
      },
      breakpoints: {
        900: {
          slidesPerView: 3,
          spaceBetween: 20,
        },
        1200: {
          slidesPerView: 4,
          spaceBetween: 24,
        },
      },
    });
  });
</script>

{% schema %}
{
  "name": "Collection List",
  "settings": [],
  "blocks": [
    {
      "type": "product_item",
      "name": "thẻ sản phẩm",
      "settings": [
        {
          "type": "number",
          "id": "id",
          "label": "ID",
          "default": 1
        },

        {
          "type": "image_picker",
          "id": "image",
          "label": "Ảnh"
        },

        {
          "type": "text",
          "id": "device_type",
          "label": "Tên thiết bị",
          "default": "headphones"
        },

        {
          "type": "text",
          "id": "description",
          "label": "Mô tả",
          "default": "immersive audio"
        },

        {
          "type": "number",
          "id": "quantity",
          "label": "Số lượng",
          "default": 1
        }
      ]
    }
  ]
}
{% endschema %}
