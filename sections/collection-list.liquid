<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.css"
/>

<script src="https://cdn.jsdelivr.net/npm/swiper@12/swiper-bundle.min.js" defer="defer"></script>

{%- assign fake_collections = '
      immersive audio|headphones|7,
      wireless sound|earbuds|4,
      home audio|speakers|5,
      smart wearables|smart watches|4,
      studio gear|microphones|6
    '
  | split: ','
-%}

<div class="collection-list">
  <h1>{{ section.settings.heading }}</h1>
  <div class="swiper swiper-container-{{ section.id }}">
    <div class="swiper-wrapper">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign card_collection = block.settings.collection -%}
          {%- assign item_url = card_collection.url | default: '#' -%}

          {%- if block.settings.custom_title != blank -%}
            {%- assign item_title = block.settings.custom_title -%}
          {%- elsif card_collection != blank and card_collection.title != blank -%}
            {%- assign item_title = card_collection.title -%}
          {%- else -%}
            {%- assign item_title = 'Collection ' | append: forloop.index -%}
          {%- endif -%}

          {%- if block.settings.custom_description != blank -%}
            {%- assign item_description = block.settings.custom_description -%}
          {%- elsif card_collection != blank and card_collection.description != blank -%}
            {%- assign item_description = card_collection.description | strip_html -%}
          {%- else -%}
            {%- assign item_description = 'Explore collection' -%}
          {%- endif -%}

          {%- if block.settings.custom_image != blank -%}
            {%- assign item_image = block.settings.custom_image | image_url -%}
          {%- elsif card_collection != blank and card_collection.image != blank -%}
            {%- assign item_image = card_collection.image | image_url -%}
          {%- elsif card_collection != blank and card_collection.featured_image != blank -%}
            {%- assign item_image = card_collection.featured_image | image_url -%}
          {%- else -%}
            {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
            {%- assign placeholder_name = 'collection-' | append: placeholder_index -%}
            {%- assign item_image = placeholder_name
              | placeholder_svg_tag
              | base64_encode
              | prepend: 'data:image/svg+xml;base64,'
            -%}
          {%- endif -%}

          {%- if card_collection != blank -%}
            {%- assign item_quantity = card_collection.all_products_count -%}
          {%- else -%}
            {%- assign item_quantity = 0 -%}
          {%- endif -%}

          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <a href="{{ item_url }}" style="text-decoration: none; color: inherit; display: block;">
              <div class="view">
                <img src="{{ item_image }}" alt="{{ item_title | escape }}" width="100%" height="100%">
                <div>{{ item_description }}</div>
              </div>
              <div class="info">
                <div>
                  {% if forloop.index < 10 %}0{% endif -%}
                  {{- forloop.index }}. {{ item_title }}
                </div>
                <div>{{ item_quantity }}</div>
              </div>
            </a>
          </div>
        {%- endfor -%}

      {%- else -%}
        {%- for item in fake_collections -%}
          {%- assign item_data = item | strip | split: '|' -%}
          {%- assign description = item_data[0] -%}
          {%- assign title = item_data[1] -%}
          {%- assign quantity = item_data[2] -%}

          {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          {%- assign placeholder_name = 'collection-' | append: placeholder_index -%}
          {%- assign placeholder_image = placeholder_name
            | placeholder_svg_tag
            | base64_encode
            | prepend: 'data:image/svg+xml;base64,'
          -%}

          <div class="swiper-slide">
            <a href="#" style="text-decoration: none; color: inherit; display: block;">
              <div class="view">
                <img src="{{ placeholder_image }}" alt="{{ title | escape }}" width="100%" height="100%">
                <div>{{ description }}</div>
              </div>
              <div class="info">
                <div>
                  {% if forloop.index < 10 %}0{% endif -%}
                  {{- forloop.index }}. {{ title }}
                </div>
                <div>{{ quantity }}</div>
              </div>
            </a>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="swiper-scrollbar-wrapper">
      <div class="swiper-scrollbar"></div>
    </div>
  </div>
</div>

{%- stylesheet -%}
  .collection-list {
    padding: 4.5rem 15vw;
    font-family: 'Mona Sans', sans-serif;
    background-color: var(--section-bg-color);
  }

  .collection-list > h1 {
    text-transform: uppercase;
    font-size: 2.5rem;
    color: var(--heading-color);
    margin-bottom: 1.7rem;
  }

  .collection-list .swiper .view {
    position: relative;
    margin-bottom: 1rem;
    aspect-ratio: 1/1;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
  }

  .collection-list .swiper .view img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .collection-list .swiper .view > div {
    position: absolute;
    bottom: 1.1rem;
    left: 1.6rem;
    color: var(--image-text-color);
    text-transform: capitalize;
  }

  .collection-list .swiper .info {
    display: flex;
    justify-content: space-between;
    padding: 1rem 1rem;
    background-color: var(--info-bg-color);
    color: var(--info-text-color);
    border-radius: 10px;
    text-transform: capitalize;
  }

  .collection-list .swiper .swiper-scrollbar-wrapper {
    display: flex;
    justify-content: center;
  }

  .collection-list .swiper .swiper-scrollbar {
    background: var(--scrollbar-bg-color);
    height: 4px;
    border-radius: 4px;
    margin-top: 20px;
    position: relative !important;
    width: 20%;
  }

  .collection-list .swiper .swiper-scrollbar-drag {
    background: var(--scrollbar-drag-color);
    border-radius: 4px;
    width: 20%;
  }

  @media screen and (max-width: 1500px) {
    .collection-list {
      padding: 4rem 10vw;
    }
  }

  @media screen and (max-width: 1300px) {
    .collection-list {
      padding: 3.5rem 8vw;
    }

    .collection-list > h1 {
      font-size: 2rem;
    }
  }

  @media screen and (max-width: 750px) {
    .collection-list > h1 {
      text-align: center;
      font-size: 1.7rem;
    }
  }
{%- endstylesheet -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --image-text-color: {{ section.settings.image_text_color }};
    --info-bg-color: {{ section.settings.info_bg_color }};
    --info-text-color: {{ section.settings.info_text_color }};
    --scrollbar-bg-color: {{ section.settings.scrollbar_bg_color }};
    --scrollbar-drag-color: {{ section.settings.scrollbar_drag_color }};
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let collectionSwiper = null;

    function initSwiper() {
      if (collectionSwiper !== null && typeof collectionSwiper.destroy === 'function') {
        collectionSwiper.destroy(true, true);
      }

      collectionSwiper = new Swiper('.swiper-container-{{ section.id }}', {
        slidesPerView: 2,
        spaceBetween: 16,
        grabCursor: true,
        scrollbar: {
          el: '.swiper-scrollbar',
          draggable: true,
        },
        breakpoints: {
          900: {
            slidesPerView: 3,
            spaceBetween: 20,
          },
          1200: {
            slidesPerView: 4,
            spaceBetween: 24,
          },
        },
      });
    }

    initSwiper();

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initSwiper();
      }
    });
  });
</script>

{% schema %}
{
  "name": "Collection List",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề lớn",
      "default": "explore collections"
    },
    {
      "type": "header",
      "content": "Cài đặt màu sắc"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Màu nền section",
      "default": "#f4f5f4"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Màu chữ tiêu đề lớn",
      "default": "#3e4430"
    },
    {
      "type": "color",
      "id": "image_text_color",
      "label": "Màu chữ mô tả trên ảnh",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "info_bg_color",
      "label": "Màu nền khung thông tin (info)",
      "default": "#ecefe9"
    },
    {
      "type": "color",
      "id": "info_text_color",
      "label": "Màu chữ khung thông tin (info)",
      "default": "#3e4430"
    },
    {
      "type": "color",
      "id": "scrollbar_bg_color",
      "label": "Màu nền thanh scrollbar",
      "default": "rgba(0,0,0,0.1)"
    },
    {
      "type": "color",
      "id": "scrollbar_drag_color",
      "label": "Màu thanh trượt scrollbar",
      "default": "#3e4430"
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Bộ sưu tập (Collection)",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Chọn bộ sưu tập"
        },
        {
          "type": "header",
          "content": "Custom Content (Tùy chỉnh nội dung)"
        },
        {
          "type": "paragraph",
          "content": "Nhập thông tin bên dưới nếu bạn muốn ghi đè dữ liệu mặc định của bộ sưu tập."
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Ảnh tùy chỉnh"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Tiêu đề tùy chỉnh (Title)"
        },
        {
          "type": "text",
          "id": "custom_description",
          "label": "Mô tả tùy chỉnh (Description)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List"
    }
  ]
}
{% endschema %}
