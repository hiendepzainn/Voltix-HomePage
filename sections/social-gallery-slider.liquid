      "type": "header",
      "content": "Kích thước chiều cao ảnh"
    },
    {
      "type": "range",
      "id": "base_height_desktop",
      "min": 180,
      "max": 450,
      "step": 10,
      "unit": "px",
      "label": "Chiều cao mặc định (Desktop)",
