{%- stylesheet -%}
  .top-tech-picks {
    padding: var(--section-padding-y) var(--section-padding-x);
    font-family: 'Mona Sans', sans-serif;
    background-color: var(--section-bg-color);
  }

  .top-tech-picks > h1 {
    text-align: center;
    text-transform: uppercase;
    font-size: 3rem;
    color: var(--heading-color);
    margin-bottom: 1rem;
  }

  .top-tech-picks .tab-list {
    display: flex;
    justify-content: center;
    gap: 2rem;
    text-transform: capitalize;
    color: var(--tab-text-color);
    margin-bottom: 2rem;
  }

  .top-tech-picks .tab-list .tab {
    padding: 0.5rem;
    cursor: pointer;
  }

  .top-tech-picks .tab-list .tab.active {
    border-bottom: 2.5px solid var(--tab-active-color);
  }

  .top-tech-picks .contents .content {
    display: none;
  }

  .top-tech-picks .contents .content.active {
    display: block;
  }

  .top-tech-picks .contents .content .swiper .card {
    background-color: var(--card-bg-color);
    padding: 0.5rem;
    border-radius: 20px;
  }

  .top-tech-picks .contents .content .swiper .card .image {
    background-color: antiquewhite;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 20px 20px 0px 0px;
    overflow: hidden;
    position: relative;
  }

  .top-tech-picks .contents .content .swiper .card .image img:nth-child(1) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    scale: 1.2;
  }

  .top-tech-picks .contents .content .swiper .card .image img:nth-child(2) {
    z-index: 15;
    position: absolute;
    top: 0;
    left: 0;
    scale: 1.05;
  }

  .top-tech-picks .contents .content .swiper .card .image .img_front {
    transition: opacity 0.7s ease, scale 0.7s ease;
  }

  .top-tech-picks .contents .content .swiper .card .image:hover .img_front {
    opacity: 0;
    scale: 1.2;
  }

  .top-tech-picks .contents .content .swiper .card .image .img_back {
    transition: scale 0.7s ease;
  }

  .top-tech-picks .contents .content .swiper .card .image:hover .img_back {
    scale: 1.05;
  }

  .top-tech-picks .contents .content .swiper .card .special_feature {
    background-color: var(--badge-bg-color);
    color: var(--badge-text-color);
    padding: 0.7rem 1.2rem;
    border-radius: 0px 0px 20px 20px;
    font-size: 0.9rem;
  }

  .top-tech-picks .contents .content .swiper .card .line_1 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0rem 1.5rem;
    color: var(--product-title-color);
    font-size: 1.1rem;
    margin: 1.2rem 0rem 0rem;
  }

  .top-tech-picks .contents .content .swiper .card .line_1 span {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    background-color: var(--cart-btn-bg-color);
    color: var(--cart-btn-text-color);
    padding: 0.2rem 0.7rem;
    border-radius: 14px;
  }

  .top-tech-picks .contents .content .swiper .card .line_1 span svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .top-tech-picks .contents .content .swiper .card .line_2 {
    padding: 0rem 1.5rem;
    color: var(--product-price-color);
    margin-bottom: 0.5rem;
  }

  .top-tech-picks .swiper .swiper-scrollbar-wrapper {
    display: flex;
    justify-content: center;
  }

  .top-tech-picks .swiper .swiper-scrollbar {
    background: rgba(0, 0, 0, 0.1);
    height: 4px;
    border-radius: 4px;
    margin-top: 2.5rem;
    position: relative !important;
    width: 20%;
  }

  .top-tech-picks .swiper .swiper-scrollbar-drag {
    background: #3e4430;
    border-radius: 4px;
    width: 20%;
  }

  @media screen and (max-width: 1500px) {
    .top-tech-picks {
      padding: var(--section-padding-y-tablet) 10vw;
    }
  }

  @media screen and (max-width: 1300px) {
    .top-tech-picks {
      padding: var(--section-padding-y-mobile) 8vw;
    }

    .top-tech-picks > h1 {
      font-size: 2rem;
    }
  }

  @media screen and (max-width: 750px) {
    .top-tech-picks > h1 {
      font-size: 1.7rem;
    }
  }
{%- endstylesheet -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --tab-text-color: {{ section.settings.tab_text_color }};
    --tab-active-color: {{ section.settings.tab_active_color }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --badge-bg-color: {{ section.settings.badge_bg_color }};
    --badge-text-color: {{ section.settings.badge_text_color }};
    --product-title-color: {{ section.settings.product_title_color }};
    --product-price-color: {{ section.settings.product_price_color }};
    --cart-btn-bg-color: {{ section.settings.cart_btn_bg_color }};
    --cart-btn-text-color: {{ section.settings.cart_btn_text_color }};
    --section-padding-y: {{ section.settings.padding_top }}rem;
    --section-padding-x: {{ section.settings.padding_x }}vw;
    --section-padding-y-tablet: {{ section.settings.padding_top | times: 0.8 }}rem;
    --section-padding-y-mobile: {{ section.settings.padding_top | times: 0.6 }}rem;
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tabList = document.querySelectorAll('.top-tech-picks .tab-list .tab');
    const contentList = document.querySelectorAll('.top-tech-picks .contents .content');

    tabList.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-tab');

        tabList.forEach((t) => t.classList.remove('active'));
        contentList.forEach((c) => c.classList.remove('active'));

        tab.classList.add('active');
        document.getElementById(targetId).classList.add('active');

        // Trigger resize để Swiper tính toán lại kích thước hiển thị khi đổi tab
        window.dispatchEvent(new Event('resize'));
      });
    });
  });
</script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let swipers = {};

    function initSwipers() {
      ['1', '2', '3'].forEach(function (index) {
        const selector = '.swiper-container-{{ section.id }}-' + index;
        const scrollbarSelector = '.swiper-scrollbar-' + index;

        if (swipers[index] && typeof swipers[index].destroy === 'function') {
          swipers[index].destroy(true, true);
        }

        swipers[index] = new Swiper(selector, {
          slidesPerView: 2,
          spaceBetween: 16,
          grabCursor: true,
          scrollbar: {
            el: scrollbarSelector,
            draggable: true,
          },
          breakpoints: {
            900: {
              slidesPerView: 3,
              spaceBetween: 20,
            },
            1200: {
              slidesPerView: 4,
              spaceBetween: 24,
            },
          },
        });
      });
    }

    initSwipers();

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initSwipers();
      }
    });
  });
</script>

