<div class="top-tech-picks">
  <h1>{{ section.settings.heading }}</h1>

  <div class="tab-list">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign tab_collection = block.settings.collection -%}
        {%- if block.settings.tab_title != blank -%}
          {%- assign tab_name = block.settings.tab_title -%}
        {%- elsif tab_collection != blank and tab_collection.title != blank -%}
          {%- assign tab_name = tab_collection.title -%}
        {%- else -%}
          {%- assign tab_name = 'Collection ' | append: forloop.index -%}
        {%- endif -%}

        <div
          class="tab {% if forloop.first %}active{% endif %}"
          data-tab="tab-{{ section.id }}-{{ forloop.index }}"
          {{ block.shopify_attributes }}
        >
          {{ tab_name }}
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <div
          class="tab {% if forloop.first %}active{% endif %}"
          data-tab="tab-{{ section.id }}-{{ i }}"
        >
          Collection 0{{ i }}
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="contents">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign tab_index = forloop.index -%}
        {%- assign tab_collection = block.settings.collection -%}

        <div class="content {% if forloop.first %}active{% endif %}" id="tab-{{ section.id }}-{{ tab_index }}">
          <div class="swiper swiper-container-{{ section.id }}-{{ tab_index }}" data-swiper-index="{{ tab_index }}">
            <div class="swiper-wrapper">
              {%- if tab_collection != blank and tab_collection.products.size > 0 -%}
                {%- for product in tab_collection.products -%}
                  {%- if product.featured_image != blank -%}
                    {%- assign front_image = product.featured_image | image_url: width: 1920 -%}
                    {%- if product.images.size > 1 and product.images[1] != blank -%}
                      {%- assign back_image = product.images[1] | image_url: width: 800 -%}
                    {%- else -%}
                      {%- assign back_image = front_image -%}
                    {%- endif -%}
                  {%- else -%}
                    {%- assign placeholder_index = forloop.index0 | modulo: 6 | plus: 1 -%}
                    {%- assign placeholder_name = 'product-' | append: placeholder_index -%}
                    {%- assign front_image = placeholder_name
                      | placeholder_svg_tag
                      | base64_encode
                      | prepend: 'data:image/svg+xml;base64,'
                    -%}
                    {%- assign back_image = front_image -%}
                  {%- endif -%}

                  {%- assign special_feature = product.type | default: product.vendor -%}
                  {%- if special_feature == blank -%}
                    {%- assign special_feature = 'Featured Product' -%}
                  {%- endif -%}

                  <div class="swiper-slide">
                    <a href="{{ product.url }}" style="text-decoration: none; color: inherit; display: block;">
                      <div class="card">
                        <div class="image">
                          <img
                            class="img_back"
                            src="{{ back_image }}"
                            alt="{{ product.title | escape }}"
                            width="100%"
                            height="100%"
                          >
                          <img
                            class="img_front"
                            src="{{ front_image }}"
                            alt="{{ product.title | escape }}"
                            width="100%"
                            height="100%"
                          >
                        </div>
                        <div class="special_feature">
                          <div>{{ special_feature }}</div>
                        </div>
                        <div class="line_1">
                          <div>{{ product.title }}</div>
                          <span>{{ 'icon-cart.svg' | inline_asset_content }}</span>
                        </div>
                        <div class="line_2">{{ product.price | money }}</div>
                      </div>
                    </a>
                  </div>
                {%- endfor -%}

              {%- else -%}
                {%- for item_idx in (1..5) -%}
                  {%- assign placeholder_index = tab_index | plus: item_idx | modulo: 6 | plus: 1 -%}
                  {%- assign placeholder_name = 'product-' | append: placeholder_index -%}
                  {%- assign placeholder_img = placeholder_name
                    | placeholder_svg_tag
                    | base64_encode
                    | prepend: 'data:image/svg+xml;base64,'
                  -%}
                  {%- assign sample_price = item_idx | times: 100 -%}

                  <div class="swiper-slide">
                    <a href="#" style="text-decoration: none; color: inherit; display: block;">
                      <div class="card">
                        <div class="image">
                          <img
                            class="img_back"
                            src="{{ placeholder_img }}"
                            alt="Sample Product {{ item_idx }}"
                            width="100%"
                            height="100%"
                          >
                          <img
                            class="img_front"
                            src="{{ placeholder_img }}"
                            alt="Sample Product {{ item_idx }}"
                            width="100%"
                            height="100%"
                          >
                        </div>
                        <div class="special_feature">
                          <div>Feature Highlight 0{{ item_idx }}</div>
                        </div>
                        <div class="line_1">
                          <div>Sample Product 0{{ item_idx }}</div>
                          <span>{{ 'icon-cart.svg' | inline_asset_content }}</span>
                        </div>
                        <div class="line_2">Rs. {{ sample_price }}.00</div>
                      </div>
                    </a>
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
            <div class="swiper-scrollbar-wrapper">
              <div class="swiper-scrollbar swiper-scrollbar-{{ section.id }}-{{ tab_index }}"></div>
            </div>
          </div>
        </div>
      {%- endfor -%}

    {%- else -%}
      {%- for tab_index in (1..3) -%}
        <div class="content {% if forloop.first %}active{% endif %}" id="tab-{{ section.id }}-{{ tab_index }}">
          <div class="swiper swiper-container-{{ section.id }}-{{ tab_index }}" data-swiper-index="{{ tab_index }}">
            <div class="swiper-wrapper">
              {%- for item_idx in (1..5) -%}
                {%- assign placeholder_index_front = tab_index | plus: item_idx | modulo: 6 | plus: 1 -%}
                {%- assign placeholder_index_back = placeholder_index_front | modulo: 6 | plus: 1 -%}
                {%- assign placeholder_front = 'product-'
                  | append: placeholder_index_front
                  | placeholder_svg_tag
                  | base64_encode
                  | prepend: 'data:image/svg+xml;base64,'
                -%}
                {%- assign placeholder_back = 'product-'
                  | append: placeholder_index_back
                  | placeholder_svg_tag
                  | base64_encode
                  | prepend: 'data:image/svg+xml;base64,'
                -%}
                {%- assign sample_price = item_idx | times: 100 -%}

                <div class="swiper-slide">
                  <a href="#" style="text-decoration: none; color: inherit; display: block;">
                    <div class="card">
                      <div class="image">
                        <img
                          class="img_back"
                          src="{{ placeholder_back }}"
                          alt="Sample Product {{ item_idx }}"
                          width="100%"
                          height="100%"
                        >
                        <img
                          class="img_front"
                          src="{{ placeholder_front }}"
                          alt="Sample Product {{ item_idx }}"
                          width="100%"
                          height="100%"
                        >
                      </div>
                      <div class="special_feature">
                        <div>Feature Highlight 0{{ item_idx }}</div>
                      </div>
                      <div class="line_1">
                        <div>Sample Product {{ tab_index }}.{{ item_idx }}</div>
                        <span>{{ 'icon-cart.svg' | inline_asset_content }}</span>
                      </div>
                      <div class="line_2">Rs. {{ sample_price }}.00</div>
                    </div>
                  </a>
                </div>
              {%- endfor -%}
            </div>
            <div class="swiper-scrollbar-wrapper">
              <div class="swiper-scrollbar swiper-scrollbar-{{ section.id }}-{{ tab_index }}"></div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{%- stylesheet -%}
  .top-tech-picks {
    padding: var(--section-padding-y) var(--section-padding-x);
    font-family: 'Mona Sans', sans-serif;
    background-color: var(--section-bg-color);
  }

  .top-tech-picks > h1 {
    text-align: center;
    text-transform: uppercase;
    font-size: 3rem;
    color: var(--heading-color);
    margin-bottom: 1rem;
  }

  .top-tech-picks .tab-list {
    display: flex;
    justify-content: center;
    gap: 2rem;
    text-transform: capitalize;
    color: var(--tab-text-color);
    margin-bottom: 2rem;
  }

  .top-tech-picks .tab-list .tab {
    padding: 0.5rem;
    cursor: pointer;
  }

  .top-tech-picks .tab-list .tab.active {
    border-bottom: 2.5px solid var(--tab-active-color);
  }

  .top-tech-picks .contents .content {
    height: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }

  .top-tech-picks .contents .content.active {
    height: auto;
    overflow: visible;
    visibility: visible;
    pointer-events: auto;
  }

  .top-tech-picks .contents .content .swiper .card {
    background-color: var(--card-bg-color);
    padding: 0.5rem;
    border-radius: 20px;
  }

  .top-tech-picks .contents .content .swiper .card .image {
    background-color: antiquewhite;
    width: 100%;
    aspect-ratio: 1/1;
    border-radius: 20px 20px 0px 0px;
    overflow: hidden;
    position: relative;
  }

  .top-tech-picks .contents .content .swiper .card .image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .top-tech-picks .contents .content .swiper .card .image img:nth-child(1) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 10;
    scale: 1.2;
  }

  .top-tech-picks .contents .content .swiper .card .image img:nth-child(2) {
    z-index: 15;
    position: absolute;
    top: 0;
    left: 0;
    scale: 1.05;
  }

  .top-tech-picks .contents .content .swiper .card .image .img_front {
    transition: opacity 0.7s ease, scale 0.7s ease;
  }

  .top-tech-picks .contents .content .swiper .card .image:hover .img_front {
    opacity: 0;
    scale: 1.2;
  }

  .top-tech-picks .contents .content .swiper .card .image .img_back {
    transition: scale 0.7s ease;
  }

  .top-tech-picks .contents .content .swiper .card .image:hover .img_back {
    scale: 1.05;
  }

  .top-tech-picks .contents .content .swiper .card .special_feature {
    background-color: var(--badge-bg-color);
    color: var(--badge-text-color);
    padding: 0.7rem 1.2rem;
    border-radius: 0px 0px 20px 20px;
    font-size: 0.9rem;
  }

  .top-tech-picks .contents .content .swiper .card .line_1 {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0rem 1.5rem;
    color: var(--product-title-color);
    font-size: 1.1rem;
    margin: 1.2rem 0rem 0rem;
  }

  .top-tech-picks .contents .content .swiper .card .line_1 span {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    background-color: var(--cart-btn-bg-color);
    color: var(--cart-btn-text-color);
    padding: 0.2rem 0.7rem;
    border-radius: 14px;
  }

  .top-tech-picks .contents .content .swiper .card .line_1 span svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .top-tech-picks .contents .content .swiper .card .line_2 {
    padding: 0rem 1.5rem;
    color: var(--product-price-color);
    margin-bottom: 0.5rem;
  }

  .top-tech-picks .swiper .swiper-scrollbar-wrapper {
    display: flex;
    justify-content: center;
  }

  .top-tech-picks .swiper .swiper-scrollbar {
    background: rgba(0, 0, 0, 0.1);
    height: 4px;
    border-radius: 4px;
    margin-top: 2.5rem;
    position: relative !important;
    width: 20%;
  }

  .top-tech-picks .swiper .swiper-scrollbar-drag {
    background: #3e4430;
    border-radius: 4px;
    width: 20%;
  }

  @media screen and (max-width: 1500px) {
    .top-tech-picks {
      padding: var(--section-padding-y-tablet) 10vw;
    }
  }

  @media screen and (max-width: 1300px) {
    .top-tech-picks {
      padding: var(--section-padding-y-mobile) 8vw;
    }

    .top-tech-picks > h1 {
      font-size: 2rem;
    }
  }

  @media screen and (max-width: 750px) {
    .top-tech-picks > h1 {
      font-size: 1.7rem;
    }
  }
{%- endstylesheet -%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-bg-color: {{ section.settings.bg_color }};
    --heading-color: {{ section.settings.heading_color }};
    --tab-text-color: {{ section.settings.tab_text_color }};
    --tab-active-color: {{ section.settings.tab_active_color }};
    --card-bg-color: {{ section.settings.card_bg_color }};
    --badge-bg-color: {{ section.settings.badge_bg_color }};
    --badge-text-color: {{ section.settings.badge_text_color }};
    --product-title-color: {{ section.settings.product_title_color }};
    --product-price-color: {{ section.settings.product_price_color }};
    --cart-btn-bg-color: {{ section.settings.cart_btn_bg_color }};
    --cart-btn-text-color: {{ section.settings.cart_btn_text_color }};
    --section-padding-y: {{ section.settings.padding_top }}rem;
    --section-padding-x: {{ section.settings.padding_x }}vw;
    --section-padding-y-tablet: {{ section.settings.padding_top | times: 0.8 }}rem;
    --section-padding-y-mobile: {{ section.settings.padding_top | times: 0.6 }}rem;
  }
{%- endstyle -%}

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionEl = document.getElementById('shopify-section-{{ section.id }}');
    if (!sectionEl) return;

    let swipers = {};

    function initTabs() {
      const tabList = sectionEl.querySelectorAll('.top-tech-picks .tab-list .tab');
      const contentList = sectionEl.querySelectorAll('.top-tech-picks .contents .content');

      tabList.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetId = tab.getAttribute('data-tab');

          tabList.forEach((t) => t.classList.remove('active'));
          contentList.forEach((c) => c.classList.remove('active'));

          tab.classList.add('active');
          const targetContent = document.getElementById(targetId);
          if (targetContent) {
            targetContent.classList.add('active');
          }

          window.dispatchEvent(new Event('resize'));
        });
      });
    }

    function initSwipers() {
      const swiperElements = sectionEl.querySelectorAll('.swiper');

      swiperElements.forEach(function (swiperEl) {
        const index = swiperEl.getAttribute('data-swiper-index');
        const selector = '.swiper-container-{{ section.id }}-' + index;
        const scrollbarSelector = '.swiper-scrollbar-{{ section.id }}-' + index;

        if (swipers[index] && typeof swipers[index].destroy === 'function') {
          swipers[index].destroy(true, true);
        }

        swipers[index] = new Swiper(selector, {
          slidesPerView: 2,
          spaceBetween: 16,
          grabCursor: true,
          scrollbar: {
            el: scrollbarSelector,
            draggable: true,
          },
          breakpoints: {
            900: {
              slidesPerView: 3,
              spaceBetween: 20,
            },
            1200: {
              slidesPerView: 4,
              spaceBetween: 24,
            },
          },
        });
      });
    }

    initTabs();
    initSwipers();

    document.addEventListener('shopify:section:load', function (event) {
      if (event.detail.sectionId === '{{ section.id }}') {
        initTabs();
        initSwipers();
      }
    });
  });
</script>

