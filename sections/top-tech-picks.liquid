<div class="top-tech-picks">
  <h1>{{ section.settings.heading }}</h1>

  <div class="tab-list">
    <div class="tab active" data-tab="tab-1">best sellers</div>
    <div class="tab" data-tab="tab-2">expert pick</div>
    <div class="tab" data-tab="tab-3">new arrivals</div>
  </div>

  <div class="contents">
    <!-- TAB 1: BEST SELLERS -->
    <div class="content active" id="tab-1">
      <div class="swiper swiper-container-{{ section.id }}-1">
        <div class="swiper-wrapper">
          {%- if section.blocks.size > 0 -%}
            {%- for block in section.blocks -%}
              <div class="swiper-slide">
                <div class="card" {{ block.shopify_attributes }}>
                  <div class="image">
                    <img
                      class="img_back"
                      src="{{ block.settings.img_back | image_url: width: 800 }}"
                      alt="image"
                      width="100%"
                      height="100%"
                    >
                    <img
                      class="img_front"
                      src="{{ block.settings.img_front | image_url: width: 1920 }}"
                      alt="image"
                      width="100%"
                      height="100%"
                    >
                  </div>
                  <div class="special_feature">
                    <div>{{ block.settings.special_feature }}</div>
                  </div>
                  <div class="line_1">
                    <div>{{ block.settings.name }}</div>
                    <span>{{ 'icon-cart.svg' | inline_asset_content }}</span>
                  </div>
                  <div class="line_2">Rs. {{ block.settings.price }}.00</div>
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for item in top_tech_picks_data -%}
              {%- assign item_data = item | strip | split: '|' -%}
              {%- assign img_url_1 = item_data[1] -%}
              {%- assign img_url_2 = item_data[2] -%}
              {%- assign special_feature = item_data[3] -%}
              {%- assign name = item_data[4] -%}
              {%- assign price = item_data[5] -%}

              <div class="swiper-slide">
                <div class="card">
                  <div class="image">
                    <img class="img_back" src="{{ img_url_2 }}" alt="image" width="100%" height="100%">
                    <img class="img_front" src="{{ img_url_1 }}" alt="image" width="100%" height="100%">
                  </div>
