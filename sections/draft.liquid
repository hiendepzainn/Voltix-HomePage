{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 20px;
    padding-right: 20px;
  }
  .feature-heading {
    text-align: center;
    font-size: 28px;
    margin-bottom: 30px;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
  }
  .feature-card {
    background: #f9f9f9;
    padding: 24px;
    border-radius: 8px;
    border: 1px solid #eaeaea;
  }
  .feature-card h3 {
    margin-top: 0;
    font-size: 18px;
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  {%- if section.settings.title != blank -%}
    <h2 class="feature-heading">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  <div class="feature-grid">
    {%- if section.blocks.size > 0 -%}
      <!-- TRƯỜNG HỢP 1: Merchant ĐÃ có thêm/quản lý blocks trên Editor -->
      {%- for block in section.blocks -%}
        <div class="feature-card" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description | escape }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <!-- TRƯỜNG HỢP 2: Fallback (Chưa có block nào, vẽ sẵn 2 block mẫu tĩnh) -->
      <div class="feature-card">
        <h3>Miễn phí vận chuyển (Mẫu)</h3>
        <p>Áp dụng cho mọi đơn hàng từ 500k trên toàn quốc.</p>
      </div>
      <div class="feature-card">
        <h3>Đổi trả dễ dàng (Mẫu)</h3>
        <p>Cam kết đổi trả trong vòng 30 ngày nếu có lỗi.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Học Blocks Đơn Giản",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Tiêu đề Section",
      "default": "Tính Năng Nổi Bật"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Khoảng cách trên",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Khoảng cách dưới",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feature_item",
      "name": "Khối tính năng",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Tiêu đề khối",
          "default": "Miễn phí vận chuyển"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Mô tả khối",
          "default": "Áp dụng cho mọi đơn hàng từ 500k trên toàn quốc."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Học Blocks Đơn Giản",
      "blocks": [
        {
          "type": "feature_item"
        },
        {
          "type": "feature_item"
        }
      ]
    }
  ]
}
{% endschema %}
