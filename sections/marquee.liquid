{%- style -%}
  #shopify-section-{{ section.id }} {
    --marquee-bg: {{ section.settings.bg_color }};
    --marquee-text: {{ section.settings.text_color }};
    --marquee-height: {{ section.settings.section_height }}vh;
    --marquee-pt: {{ section.settings.padding_top }}px;
    --marquee-pb: {{ section.settings.padding_bottom }}px;
    --marquee-speed: {{ section.settings.speed }}s;
    --marquee-gap: {{ section.settings.item_gap }}px;
    --marquee-font-size: {{ section.settings.font_size_desktop }}px;
    --marquee-icon-size: {{ section.settings.icon_size_desktop }}px;
  }

  .marquee-section-{{ section.id }} {
    background-color: var(--marquee-bg);
    color: var(--marquee-text);
    min-height: var(--marquee-height);
    padding-top: var(--marquee-pt);
    padding-bottom: var(--marquee-pb);
    display: flex;
    align-items: center;
    overflow: hidden;
    position: relative;
    width: 100%;
    box-sizing: border-box;
    user-select: none;
    font-family: 'Mona Sans', sans-serif;
  }

  .marquee-viewport-{{ section.id }} {
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .marquee-track-{{ section.id }} {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    min-width: 100%;
    justify-content: space-around;
    animation: marquee-scroll-{{ section.id }} var(--marquee-speed) linear infinite;
    {% if section.settings.direction == 'right' %}
      animation-direction: reverse;
    {% endif %}
  }

  {% if section.settings.pause_on_hover %}
    .marquee-section-{{ section.id }}:hover .marquee-track-{{ section.id }} {
      animation-play-state: paused;
    }
  {% endif %}

  .marquee-item-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-right: var(--marquee-gap);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .marquee-icon-{{ section.id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--marquee-icon-size);
    height: var(--marquee-icon-size);
    color: var(--marquee-text);
    flex-shrink: 0;
  }

  .marquee-icon-{{ section.id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .marquee-icon-{{ section.id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .marquee-text-{{ section.id }} {
    font-size: var(--marquee-font-size);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--marquee-text);
  }

  @keyframes marquee-scroll-{{ section.id }} {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-100%);
    }
  }

  @media screen and (max-width: 1024px) {
    .marquee-item-{{ section.id }} {
      gap: 10px;
      margin-right: calc(var(--marquee-gap) * 0.75);
    }
    .marquee-text-{{ section.id }} {
      font-size: calc(var(--marquee-font-size) * 0.85);
    }
    .marquee-icon-{{ section.id }} {
      width: calc(var(--marquee-icon-size) * 0.85);
      height: calc(var(--marquee-icon-size) * 0.85);
    }
  }

  @media screen and (max-width: 767px) {
    .marquee-section-{{ section.id }} {
      min-height: calc(var(--marquee-height) * 0.85);
    }
    .marquee-item-{{ section.id }} {
      gap: 8px;
      margin-right: calc(var(--marquee-gap) * 0.55);
    }
    .marquee-text-{{ section.id }} {
      font-size: calc(var(--marquee-font-size) * 0.72);
    }
    .marquee-icon-{{ section.id }} {
      width: calc(var(--marquee-icon-size) * 0.75);
      height: calc(var(--marquee-icon-size) * 0.75);
    }
  }
{%- endstyle -%}

<div class="marquee-section-{{ section.id }}" role="region">
  <div class="marquee-viewport-{{ section.id }}">
    {% for i in (1..4) %}
      <div
        class="marquee-track-{{ section.id }}"
        {% if i > 1 %}
          aria-hidden="true"
        {% endif %}
      >
        {% if section.blocks.size > 0 %}
          {% for block in section.blocks %}
            <div
              class="marquee-item-{{ section.id }}"
              {% if i == 1 %}
                {{- block.shopify_attributes -}}
              {% endif %}
            >
              {%- if block.settings.icon_image != blank
                or block.settings.custom_svg != blank
                or block.settings.preset_icon != 'none'
              -%}
                <span class="marquee-icon-{{ section.id }}">
                  {%- if block.settings.icon_image != blank -%}
                    {{
                      block.settings.icon_image
                      | image_url: width: 80
                      | image_tag: loading: 'lazy', alt: block.settings.text
                    }}
                  {%- elsif block.settings.custom_svg != blank -%}
                    {{ block.settings.custom_svg }}
                  {%- else -%}
                    {%- case block.settings.preset_icon -%}
                      {%- when 'shipping' -%}
                        <svg viewBox="0 0 24 24">
                          <path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M2 8h4"/><path d="M2 11h3"/>
                        </svg>
                      {%- when 'checkout' -%}
                        <svg viewBox="0 0 24 24">
                          <rect x="2" y="5" width="16" height="14" rx="2"/><line x1="2" y1="10" x2="18" y2="10"/><line x1="6" y1="15" x2="10" y2="15"/><path d="M19 11l3 1.5v3.5c0 2.5-3 4-3 4s-3-1.5-3-4v-3.5L19 11z"/>
                        </svg>
                      {%- when 'support' -%}
                        <svg viewBox="0 0 24 24">
                          <path d="M3 14v-3a9 9 0 0 1 18 0v3"/><path d="M21 14a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2z"/><path d="M3 14a2 2 0 0 0 2 2h1v-5H5a2 2 0 0 0-2 2z"/><path d="M18 16v1a3 3 0 0 1-3 3h-3"/><circle cx="11" cy="20" r="1"/><rect x="8" y="9" width="8" height="6" rx="1.5"/>
                        </svg>
                      {%- when 'returns' -%}
                        <svg viewBox="0 0 24 24">
                          <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7l5 2.8v5.4L12 18l-5-2.8V9.8L12 7z"/><path d="M12 12.5L17 9.8"/><path d="M12 12.5v5.5"/><path d="M12 12.5L7 9.8"/>
                        </svg>
                      {%- when 'warranty' -%}
                        <svg viewBox="0 0 24 24">
                          <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-7"/><line x1="8" y1="9" x2="11" y2="9"/><line x1="8" y1="13" x2="10" y2="13"/><path d="M9 17l1.5 1.5L14 15"/><path d="M18 3l4 1.8v4.2c0 3-4 4.8-4 4.8s-4-1.8-4-4.8V4.8L18 3z"/>
                        </svg>
                    {%- endcase -%}
                  {%- endif -%}
                </span>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <span class="marquee-text-{{ section.id }}">
                  {{ block.settings.text | escape }}
                </span>
              {%- endif -%}
            </div>
          {% endfor %}

        {% else %}
          <div class="marquee-item-{{ section.id }}">
            <span class="marquee-icon-{{ section.id }}">
              <svg viewBox="0 0 24 24">
                <path d="M10 17h4V5H2v12h3"/><path d="M20 17h2v-3.34a4 4 0 0 0-1.17-2.83L19 9h-5v8h1"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/><path d="M2 8h4"/><path d="M2 11h3"/>
              </svg>
            </span>
            <span class="marquee-text-{{ section.id }}">FREE SHIPPING $149+</span>
          </div>

          <div class="marquee-item-{{ section.id }}">
            <span class="marquee-icon-{{ section.id }}">
              <svg viewBox="0 0 24 24">
                <rect x="2" y="5" width="16" height="14" rx="2"/><line x1="2" y1="10" x2="18" y2="10"/><line x1="6" y1="15" x2="10" y2="15"/><path d="M19 11l3 1.5v3.5c0 2.5-3 4-3 4s-3-1.5-3-4v-3.5L19 11z"/>
              </svg>
            </span>
            <span class="marquee-text-{{ section.id }}">SECURE CHECKOUT</span>
          </div>

          <div class="marquee-item-{{ section.id }}">
            <span class="marquee-icon-{{ section.id }}">
              <svg viewBox="0 0 24 24">
                <path d="M3 14v-3a9 9 0 0 1 18 0v3"/><path d="M21 14a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2z"/><path d="M3 14a2 2 0 0 0 2 2h1v-5H5a2 2 0 0 0-2 2z"/><path d="M18 16v1a3 3 0 0 1-3 3h-3"/><circle cx="11" cy="20" r="1"/><rect x="8" y="9" width="8" height="6" rx="1.5"/>
              </svg>
            </span>
            <span class="marquee-text-{{ section.id }}">EXPERT SUPPORT</span>
          </div>

          <div class="marquee-item-{{ section.id }}">
            <span class="marquee-icon-{{ section.id }}">
              <svg viewBox="0 0 24 24">
                <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M12 7l5 2.8v5.4L12 18l-5-2.8V9.8L12 7z"/><path d="M12 12.5L17 9.8"/><path d="M12 12.5v5.5"/><path d="M12 12.5L7 9.8"/>
              </svg>
            </span>
            <span class="marquee-text-{{ section.id }}">30-DAY RETURNS</span>
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee Perks (Chữ chạy)",
  "tag": "section",
  "class": "section-marquee-perks",
  "settings": [
    {
      "type": "header",
      "content": "Cấu hình chuyển động"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Hướng chạy",
      "options": [
        {
          "value": "left",
          "label": "Chạy sang trái (Phải -> Trái)"
        },
        {
          "value": "right",
          "label": "Chạy sang phải (Trái -> Phải)"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Thời gian chạy 1 vòng (Càng nhỏ chạy càng nhanh)",
      "default": 25
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Tạm dừng khi di chuột vào",
      "default": false
    },
    {
      "type": "header",
      "content": "Kích thước & Khoảng cách"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 6,
      "max": 20,
      "step": 1,
      "unit": "vh",
      "label": "Chiều cao Section (1/12 đến 1/8 màn hình ~ 8vh - 12vh)",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding trên",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Padding dưới",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 20,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Khoảng cách giữa các Item",
      "default": 80
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Cỡ chữ (Desktop)",
      "info": "Tự động thu nhỏ theo tỷ lệ trên Tablet và Mobile",
      "default": 24
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Kích thước Icon (Desktop)",
      "default": 28
    },
    {
      "type": "header",
      "content": "Màu sắc"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Màu nền Section",
      "default": "#141B0D"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Màu chữ & Icon",
      "default": "#D5DFA7"
    }
  ],
  "blocks": [
    {
      "type": "perk_item",
      "name": "Chính sách / Ưu đãi",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Nội dung chữ",
          "default": "FREE SHIPPING $149+"
        },
        {
          "type": "select",
          "id": "preset_icon",
          "label": "Chọn Icon có sẵn",
          "options": [
            { "value": "shipping", "label": "Xe tải giao hàng (Shipping)" },
            { "value": "checkout", "label": "Thanh toán bảo mật (Checkout)" },
            { "value": "support", "label": "Tai nghe hỗ trợ (Support)" },
            { "value": "returns", "label": "Đổi trả hàng (Returns)" },
            { "value": "warranty", "label": "Bảo hành (Warranty)" },
            { "value": "none", "label": "Không dùng icon mẫu" }
          ],
          "default": "shipping"
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Ảnh Icon tùy chỉnh (Ghi đè icon mẫu)"
        },
        {
          "type": "html",
          "id": "custom_svg",
          "label": "Hoặc dán code SVG tùy chỉnh",
          "info": "Nếu nhập code SVG, hệ thống sẽ ưu tiên hiển thị SVG này thay cho icon mẫu."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee Perks (Chữ chạy)",
      "blocks": [
        {
          "type": "perk_item",
          "settings": {
            "preset_icon": "shipping",
            "text": "FREE SHIPPING $149+"
          }
        },
        {
          "type": "perk_item",
          "settings": {
            "preset_icon": "checkout",
            "text": "SECURE CHECKOUT"
          }
        },
        {
          "type": "perk_item",
          "settings": {
            "preset_icon": "support",
            "text": "EXPERT SUPPORT"
          }
        },
        {
          "type": "perk_item",
          "settings": {
            "preset_icon": "returns",
            "text": "30-DAY RETURNS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
