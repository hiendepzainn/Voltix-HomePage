    {
      "type": "header",
      "content": "Khoảng cách trên / dưới"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "offer_card",
      "name": "Thẻ ưu đãi (Offer Card)",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Ảnh nền ưu đãi"
