          "type": "header",
          "content": "Nội dung chữ & Nút bấm"
        },
        {
          "type": "text",
          "id": "large_text",
          "label": "Text lớn (Tiêu đề card)",
          "default": "UP TO 20% OFF SMART WATCHES"
        },
        {
          "type": "textarea",
          "id": "small_text",
          "label": "Text nhỏ (Mô tả ngắn)",
          "default": "Timeless Style, Now At Limited-time Prices."
        },
        {
          "type": "text",
          "id": "button_label",
