<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>

{%- style -%}
  .lto-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.bg_color }};
    overflow: hidden;
    font-family: 'Mona Sans', sans-serif;
  }

  .lto-section-{{ section.id }} .swiper-wrapper{
    display: flex;
    justify-content: center;
  }

  .lto-container {
    max-width: {{ section.settings.container_width }}vw;
    margin: 0 auto;
    padding: 0 20px;
  }

  .lto-section-title {
    text-align: center;
    font-size: clamp(24px, 3vw, 36px);
    font-weight: 800;
    color: {{ section.settings.heading_color }};
    text-transform: uppercase;
    margin: 0 0 32px 0;
    letter-spacing: 0.5px;
  }

  .lto-card {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    background-color: #d8e0d5;
    height: 45vh;
  }

  .lto-card__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .lto-card__media img,
  .lto-card__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .lto-card:hover .lto-card__media img,
  .lto-card:hover .lto-card__media svg {
    transform: scale(1.06);
  }

  .lto-card__gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 50%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0) 100%);
    z-index: 2;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .lto-card:hover .lto-card__gradient {
    opacity: 1;
  }

  .lto-card__content {
    position: relative;
    z-index: 3;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
    padding: 20px 16px 24px;
    box-sizing: border-box;
  }

  .lto-card__top {
    width: 100%;
    display: flex;
    justify-content: center;
    min-height: 28px;
  }

  .lto-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #ffffff;
    color: #1f2421;
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .lto-badge__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 12px;
    height: 12px;
  }

  .lto-badge__icon svg,
  .lto-badge__icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    fill: currentColor;
  }

  .lto-card__bottom {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .lto-card__heading {
    color: #ffffff;
    font-size: clamp(15px, 1.5vw, 20px);
    font-weight: 800;
    line-height: 1.25;
    text-transform: uppercase;
    margin: 0;
    max-width: 92%;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  }

  .lto-card__subtext {
    color: rgba(255, 255, 255, 0.92);
    font-size: clamp(10px, 0.9vw, 12px);
    font-weight: 400;
    line-height: 1.4;
    margin: 0 0 8px 0;
    max-width: 90%;
  }

  .lto-card__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: var(--btn-bg, #ffffff);
    color: var(--btn-text, #1f2421);
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: none;
    padding: 11px 22px;
    border-radius: 999px;
    letter-spacing: 0.4px;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
  }

  .lto-card:hover .lto-card__btn {
    background-color: var(--btn-text, #1f2421);
    color: var(--btn-bg, #ffffff);
  }

  @media screen and (max-width: 767px) {
    .lto-container {
      padding: 0 12px;
    }
    .lto-card__content {
      padding: 12px 10px 16px;
    }
    .lto-badge {
      padding: 4px 10px;
      font-size: 9px;
      gap: 4px;
    }
    .lto-card__btn {
      padding: 8px 14px;
      font-size: 9px;
    }
  }
{%- endstyle -%}

<section class="lto-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="lto-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="lto-section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="swiper lto-swiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {%- if section.blocks.size > 0 -%}
          {%- for block in section.blocks -%}
            <div class="swiper-slide" {{ block.shopify_attributes }}>
              <div
                class="lto-card"
                style="--btn-bg: {{ block.settings.btn_bg_color }}; --btn-text: {{ block.settings.btn_text_color }};"
                {% if block.settings.button_link != blank %}
                  onclick="window.location.href='{{ block.settings.button_link }}'"
                {% endif %}
              >
                <div class="lto-card__media">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 900
                      | image_tag: loading: 'lazy', alt: block.settings.large_text
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>

                <div class="lto-card__gradient"></div>

                <div class="lto-card__content">
                  <div class="lto-card__top">
                    {%- if block.settings.show_event_time -%}
                      <div class="lto-badge">
                        {%- if block.settings.event_icon_image != blank -%}
                          <span class="lto-badge__icon">
                            {{ block.settings.event_icon_image | image_url: width: 24 | image_tag }}
                          </span>
                        {%- elsif block.settings.event_icon_svg != blank -%}
                          <span class="lto-badge__icon">
                            {{ block.settings.event_icon_svg }}
                          </span>
                        {%- endif -%}

                        {%- if block.settings.event_time_text != blank -%}
                          <span class="lto-badge__text">{{ block.settings.event_time_text }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="lto-card__bottom">
                    {%- if block.settings.large_text != blank -%}
                      <h3 class="lto-card__heading">{{ block.settings.large_text }}</h3>
                    {%- endif -%}

                    {%- if block.settings.small_text != blank -%}
                      <p class="lto-card__subtext">{{ block.settings.small_text }}</p>
                    {%- endif -%}

                    {%- if block.settings.button_label != blank -%}
                      <a
                        href="{{ block.settings.button_link | default: '#' }}"
                        class="lto-card__btn"
                        onclick="event.stopPropagation();"
                      >
                        {{ block.settings.button_label }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}

        {%- else -%}
          {%- for i in (1..3) -%}
            {%- liquid
              case i
                when 1
                  assign default_show_time = true
                  assign default_time_text = 'Offer ended'
                  assign default_icon = '<svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>'
                  assign default_heading = 'UP TO 20% OFF SMART WATCHES'
                  assign default_subtext = 'Timeless Style, Now At Limited-time Prices.'
                  assign default_btn = 'SHOP FLASH DEALS'
                  assign img_url = '//voltix-demo.myshopify.com/cdn/shop/files/Rectangle_660_2.png?v=1784966254&width=1400'

                when 2
                  assign default_show_time = false
                  assign default_time_text = ''
                  assign default_icon = ''
                  assign default_heading = 'LIMITED - TIME OFFER EARBUDS'
                  assign default_subtext = 'Timeless Style, Now At Limited-time Prices.'
                  assign default_btn = 'EXPLORE NOW'
                  assign img_url = '//voltix-demo.myshopify.com/cdn/shop/files/Rectangle_660_4.png?v=1787057823&width=1400'
                when 3
                  assign default_show_time = true
                  assign default_time_text = 'OFFER PERIOD 15 AUG – 31 OCT'
                  assign default_icon = '<svg viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10z"/></svg>'
                  assign default_heading = 'BETTER SOUND. BETTER SAVINGS.'
                  assign default_subtext = 'Save On Headphones And Earbuds Before Deals End.'
                  assign default_btn = 'SHOP LIMITED EDITION'
                  assign img_url = '//voltix-demo.myshopify.com/cdn/shop/files/Rectangle_9420.png?v=1789124764&width=1400'
              endcase
            -%}
            <div class="swiper-slide">
              <div class="lto-card" style="--btn-bg: #ffffff; --btn-text: #1f2421;">
                <div class="lto-card__media">
                  <img
                    src="{{ img_url }}"
                    width="900"
                    height="600"
                    loading="lazy"
                    alt="image-offers"
                    class="image-tag"
                  >
                </div>
                <div class="lto-card__gradient"></div>
                <div class="lto-card__content">
                  <div class="lto-card__top">
                    {%- if default_show_time -%}
                      <div class="lto-badge">
                        <span class="lto-badge__icon">{{ default_icon }}</span>
                        <span class="lto-badge__text">{{ default_time_text }}</span>
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="lto-card__bottom">
                    <h3 class="lto-card__heading">{{ default_heading }}</h3>
                    <p class="lto-card__subtext">{{ default_subtext }}</p>
                    <a href="#" class="lto-card__btn">{{ default_btn }}</a>
                  </div>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initLTOSwiper_{{ section.id | replace: '-', '_' }}() {
      const swiperEl = document.querySelector('.lto-swiper-{{ section.id }}');
      if (!swiperEl || typeof Swiper === 'undefined') return;

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      new Swiper(swiperEl, {
        grabCursor: true,
        watchOverflow: true,
        breakpoints: {
          0: {
            slidesPerView: 2,
            spaceBetween: 12
          },
          768: {
            slidesPerView: 3,
            spaceBetween: 16
          },
          1024: {
            slidesPerView: 4,
            spaceBetween: 20
          }
        }
      });
    }

    document.addEventListener('DOMContentLoaded', initLTOSwiper_{{ section.id | replace: '-', '_' }});
    window.addEventListener('load', initLTOSwiper_{{ section.id | replace: '-', '_' }});

    if (Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:load', function (event) {
        if (event.detail.sectionId === '{{ section.id }}') {
          initLTOSwiper_{{ section.id | replace: '-', '_' }}();
        }
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Limited-Time Offers",
  "tag": "section",
  "class": "section-limited-time-offers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Tiêu đề lớn (Section Heading)",
      "default": "LIMITED-TIME OFFERS"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Màu tiêu đề lớn",
      "default": "#3d4435"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Màu nền Section",
      "default": "#ffffff"
    },
    {
