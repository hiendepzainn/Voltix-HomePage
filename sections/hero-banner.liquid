<div class="hero-banner">
  <div>
    <h1>{{ section.settings.main_text_1 }}</h1>
    <h1>{{ section.settings.main_text_2 }}</h1>
    <div class="text">{{ section.settings.description }}</div>
    <button>shop now</button>
  </div>
</div>

{% style %}
  .hero-banner {
    {%- if section.settings.bg_image != blank -%}
      background-image: url('{{ section.settings.bg_image | image_url}}');
    {%- else -%}
      background-image: url('//voltix-demo.myshopify.com/cdn/shop/files/Home_7.png?v=1787113959&width=2400');
    {%- endif -%}
    height: {{section.settings.banner_height_pc}}rem;
    background-size: cover;
    background-position-y: 45%;
    background-position-x: center;
    display: flex;
    align-items: center;
    padding: 5rem 5rem;
  }

  .hero-banner h1 {
    text-transform: uppercase;
    font-size: 4rem;
    font-weight: 600;
    color: {{section.settings.color_title}};
    letter-spacing: -0.01em;
    margin-bottom: 0.8rem;
    font-family: 'Mona Sans', sans-serif;
  }

  .hero-banner h1:nth-child(1) {
    margin-bottom: -1rem;
  }

  .hero-banner .text {
    text-transform: capitalize;
    color: {{section.settings.color_description}};
    font-weight: 600;
    font-style: normal;
    font-family: 'Mona Sans', sans-serif;
    font-size: 1.05rem;
    letter-spacing: 0.3px;
    margin-bottom: 2rem;
  }

  .hero-banner button {
    border-radius: 50px;
    text-transform: uppercase;
    transition: all 0.5s;
    padding: 1rem 2.2rem;
    background: {{section.settings.button_background_color}};
    color: {{section.settings.button_color}};
    font-family: 'Mona Sans', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    border: none;
    cursor: pointer;
  }

  .hero-banner button:hover {
    background-color: {{section.settings.button_color}};
    color: {{section.settings.button_background_color}};
  }

  @media screen and (max-width: 1350px) {
    .hero-banner h1 {
      font-size: 3rem;
    }

    .hero-banner .text {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .hero-banner h1:nth-child(1) {
      margin-bottom: -0.5rem;
    }
  }

  @media screen and (max-width: 1200px) {
    .hero-banner {
      padding: 2.5rem;
    }
  }

  @media screen and (max-width: 990px) {
    .hero-banner {
      align-items: flex-start;
      height: {{section.settings.banner_height_mobile}}rem;
      padding: 6rem 2rem;
    }

    .hero-banner h1 {
      font-size: 2rem;
    }

    .hero-banner button {
      padding: 0.7rem 1.5rem;
      font-size: 0.75rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },

    {
      "type": "range",
      "id": "banner_height_pc",
      "min": 40,
      "max": 60,
      "step": 1,
      "unit": "rem",
      "label": "Banner height (PC)",
      "default": 50
    },

    {
      "type": "range",
      "id": "banner_height_mobile",
      "min": 25,
      "max": 45,
      "step": 1,
      "unit": "rem",
      "label": "Banner height (Mobile)",
      "default": 35
    },

    {
      "type": "text",
      "id": "main_text_1",
      "label": "Title 1",
      "default": "pure sound"
    },

    {
      "type": "text",
      "id": "main_text_2",
      "label": "Title 2",
      "default": "zero distractions"
    },

    {
      "type": "color",
      "id": "color_title",
      "label": "Title Color",
      "default": "#c8cc81"
    },

    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "experience crystal-clear sound anywhere"
    },

    {
      "type": "color",
      "id": "color_description",
      "label": "Description Color",
      "default": "#fff"
    },

    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "rgba(255 255 255 / 1)"
    },

    {
      "type": "color",
      "id": "button_background_color",
      "label": "Button background color",
      "default": "rgba(62 68 48 / 1)"
    }
  ]
}
{% endschema %}
